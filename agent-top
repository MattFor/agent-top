def fit(cols, rows, size):
	wid = os.environ.get('WINDOWID')
	try:
		hints = subprocess.run(
			['xprop', '-id', wid, 'WM_NORMAL_HINTS'], capture_output=True, text=True, timeout=2
		).stdout
		inc = re.search(r'resize increment: (\d+) by (\d+)', hints)
		base = re.search(r'base size: (\d+) by (\d+)', hints)
		bw, bh = map(int, base.groups()) if base else (0, 0)
		cw, ch = map(int, inc.groups())
		# exact cell multiples: xfwm4 anchors on the requested size, then snaps, so any slack drifts the corner
		subprocess.run(['wmctrl', '-i', '-r', wid, '-e', f'9,-1,-1,{bw + cols * cw},{bh + rows * ch}'], timeout=2)
	except Exception:
		pass


def save_view():
	try:
		CONFIG.parent.mkdir(parents=True, exist_ok=True)
		CONFIG.write_text(json.dumps(VIEW, indent=1) + '\n')
	except OSError:
		pass


def main():
	if '--selftest' in sys.argv:
		selftest()
		return 0
	try:
		w = os.get_terminal_size().columns or 64
	except OSError:
		w = 64
	colored = '--no-color' not in sys.argv and (sys.stdout.isatty() or '--once' not in sys.argv)
	if '--once' in sys.argv:
		scan()
		time.sleep(0.5)  # second sample, so CPU-based work states are real
		VIEW.update(limits=True, help=True)
		print(render(scan(sync=True), w, None, colored))
		return 0
	try:
		VIEW.update({k: bool(v) for k, v in json.loads(CONFIG.read_text()).items() if k in VIEW})
	except Exception:
		pass
	if VIEW['limits']:
		SHOW_LIMITS.set()
	fd = sys.stdin.fileno()
	old = None
	running = True

	def stop(*_):
		nonlocal running
		running = False

	signal.signal(signal.SIGTERM, stop)
	signal.signal(signal.SIGHUP, stop)
	threading.Thread(target=limits_loop, daemon=True).start()
	up, down = (b'\x1b[A', b'\x1bOA', b'k'), (b'\x1b[B', b'\x1bOB', b'j')
	try:
		old = termios.tcgetattr(fd)
		tty.setcbreak(fd)
		sys.stdout.write('\033[?1049h\033[?25l\033[?1000h\033[?1006h\033[Hscanning…')
		sys.stdout.flush()
		prev = None
		scan_at = 0
		data = None
		want = None
		sel = None
		owners = []
		fit_at = time.monotonic() + 1
		fitting = '--fit' in sys.argv and os.environ.get('WINDOWID')
		while running:
			if time.monotonic() >= scan_at:
				data = scan()
				scan_at = time.monotonic() + 2
			pids = [r['pid'] for r in data['rows'] if isinstance(r, dict) and r.get('pid')]
			if sel not in pids:
				sel = None
			try:
				size = os.get_terminal_size()
			except OSError:
				size = os.terminal_size((64, 22))
			if fitting and time.monotonic() >= fit_at:
				full = render(data, 110, None, False).split('\n')
				target = (min(110, max(40, max(visible_len(x) for x in full) + 1)), min(50, len(full)))
				if target != want and target != (size.columns, size.lines):
					want = target
					threading.Thread(target=fit, args=(*target, size), daemon=True).start()
			out = render(data, size.columns, size.lines, colored, sel, owners)
			if out != prev:
				# no trailing newline: writing past the last row would scroll the screen
				sys.stdout.write('\033[H' + '\033[K\n'.join(out.split('\n')) + '\033[K\033[J')
				sys.stdout.flush()
				prev = out
			ready, _, _ = select.select([fd], [], [], 0.125)
			if not ready:
				continue
			keys = os.read(fd, 64)
			if not keys:
				break  # tty gone; select would spin
			for k in re.findall(rb'\x1b\[<[0-9;]*[Mm]|\x1b\[[0-9;]*[A-Za-z~]|\x1bO.|.', keys, re.S):
				if mouse := re.fullmatch(rb'\x1b\[<(\d+);\d+;(\d+)M', k):
					button, line = int(mouse[1]), int(mouse[2]) - 1
					if button in (64, 65):
						k = up[0] if button == 64 else down[0]
					elif button == 0 and line < len(owners) and owners[line]:
						# first click selects, a click on the selected agent jumps: focusing the popup never jumps
						if owners[line] == sel:
							threading.Thread(target=jump_and_hide, args=(sel,), daemon=True).start()
						sel = owners[line]
						continue
					else:
						continue
				if k == b'q':
					running = False
				elif k == b'\x1b':
					if sel is None:
						running = False
					sel = None
				elif (k in up or k in down) and pids:
					step = -1 if k in up else 1
					sel = pids[(pids.index(sel) + step) % len(pids)] if sel in pids else pids[0 if step > 0 else -1]
				elif k in (b'\r', b'\n') and sel:
					threading.Thread(target=jump_and_hide, args=(sel,), daemon=True).start()
				elif k in KEYS:
					VIEW[KEYS[k]] = not VIEW[KEYS[k]]
					save_view()
					SHOW_LIMITS.set() if VIEW['limits'] else SHOW_LIMITS.clear()
	except (OSError, ValueError):
		pass
	finally:
		if old is not None:
			try:
				termios.tcsetattr(fd, termios.TCSADRAIN, old)
			except OSError:
				pass
		sys.stdout.write('\033[?1000l\033[?1006l\033[?25h\033[?1049l')
		sys.stdout.flush()
	return 0


if __name__ == '__main__':
	raise SystemExit(main())
