def state_for_claude(status, transcript_mtime=None, now=None):
	if status in ('busy', 'shell', 'working', 'running'):
		return 'work'
	if status == 'idle':
		return 'idle'
	if transcript_mtime is not None and (time.time() if now is None else now) - transcript_mtime < 5:
		return 'work'
	return 'wait'


def cpu_ticks(pid, table=None):
	"""Return process plus descendant CPU ticks and descendants from a proc stat mapping."""
	table = table if table is not None else read_proc_table()
	kids = {}
	for p, info in table.items():
		kids.setdefault(info['ppid'], []).append(p)
	total = 0
	stack = [pid]
	seen = set()
	while stack:
		p = stack.pop()
		if p in seen:
			continue
		seen.add(p)
		item = table.get(p)
		if item:
			total += item['ticks']
			stack.extend(kids.get(p, ()))
	return total


def read_proc_table():
	table = {}
	try:
		pids = [x for x in os.listdir('/proc') if x.isdigit()]
	except OSError:
		return table
	for s in pids:
		try:
			raw = Path('/proc', s, 'stat').read_text()
			end = raw.rfind(')')
			parts = raw[end + 2 :].split()
			try:
				exe = os.path.basename(os.readlink(f'/proc/{s}/exe'))
			except OSError:
				exe = ''
			table[int(s)] = {
				'comm': raw[raw.find('(') + 1 : end],
				'exe': exe,
				'ppid': int(parts[1]),
				'tty': int(parts[4]),
				'ticks': int(parts[11]) + int(parts[12]),
				'start': int(parts[19]),
				'since': BTIME + int(parts[19]) / HZ,
			}
		except Exception:
			pass
	return table


def cpu_percent(pid, table, now=None):
	now = time.monotonic() if now is None else now
	ticks = cpu_ticks(pid, table)
	old = CPU_PREV.get(pid)
	CPU_PREV[pid] = (ticks, now)
	if not old or now <= old[1]:
		return 0.0
	return max(0.0, (ticks - old[0]) / HZ / (now - old[1]) * 100)


def visible_len(s):
	return len(re.sub(r'\033\[[0-9;]*m', '', s))


def truncate(s, width):
	if visible_len(s) <= width:
		return s
	out = ''
	vis = 0
	i = 0
	while i < len(s) and vis < max(0, width - 1):
		if s[i] == '\033':
			m = re.match(r'\033\[[0-9;]*m', s[i:])
			if m:
				out += m.group()
				i += len(m.group())
				continue
		out += s[i]
		i += 1
		vis += 1
	out += '…'
	if '\033[' in s:
		out += RESET
	return out


def slug(s):
	return re.sub(r'[^A-Za-z0-9]', '-', str(s))


def fmt(n):
	if n is None:
		return ''
	n = int(n)
	for unit, scale in (('G', 1e9), ('M', 1e6), ('k', 1e3)):
		if abs(n) >= scale:
			return (f'{n / scale:.1f}'.rstrip('0').rstrip('.') if abs(n) < 10 * scale else f'{n / scale:.0f}') + unit
	return str(n)


def dur(sec):
	sec = int(sec)
	return (
		f'{sec // 86400}d{sec % 86400 // 3600}h'
		if sec >= 86400
		else f'{sec // 3600}h{sec % 3600 // 60:02d}'
		if sec >= 3600
		else f'{sec // 60}m'
		if sec >= 60
		else f'{sec}s'
	)


def clock(sec):
	d, r = divmod(int(max(0, sec)), 86400)
	h, r = divmod(r, 3600)
	m, s = divmod(r, 60)
	return f'{d}d {h:02d}:{m:02d}:{s:02d}' if d else f'{h}:{m:02d}:{s:02d}' if h else f'{m}:{s:02d}'


def iso_epoch(s):
	try:
		return datetime.datetime.fromisoformat(s).timestamp()
	except (TypeError, ValueError):
		return None


def model_short(s):
	s = str(s or '')
	s = re.sub(r'^claude-', '', s)
	return re.sub(r'-\d{8}$', '', s) or '?'


def oneline(s, cap=50):
	s = ' '.join(str(s or '').split())
	return s if len(s) <= cap else s[: cap - 1].rstrip() + '…'


def block_brief(b):
	"""The tool call an assistant content block makes; None otherwise (the spinner already says thinking)."""
	t = b.get('type')
	if t in ('tool_use', 'server_tool_use'):
		i = b.get('input') if isinstance(b.get('input'), dict) else {}
		arg = (
			i.get('description')
			or (os.path.basename(i['file_path']) if i.get('file_path') else '')
			or i.get('pattern')
			or i.get('url')
			or i.get('query')
			or i.get('skill')
			or i.get('command')
			or i.get('prompt')
			or ''
		)
		name = str(b.get('name') or 'tool').split('__')[-1]
		return oneline(f'{name}: {arg}' if arg else name)
	return None


def token_sum(path):
	p = str(path)
	TOUCHED.add(p)
	try:
		st = CACHE.get(p)
		if not st or os.path.getsize(p) < st['size']:
			st = {
				'size': 0,
				'partial': b'',
				'ids': {},
				'latest': None,
				'effort': None,
				'ultra': False,
				'start': None,
				'ai': None,
				'custom': None,
				'prompt': None,
				'doing': None,
			}
		with open(p, 'rb') as f:
			f.seek(st['size'])
			chunk = f.read()
		lines = (st['partial'] + chunk).split(b'\n')
		# size from what was read, not a stat taken before it: a write in between would re-read and mangle the tail
		st = dict(st, size=st['size'] + len(chunk), partial=lines.pop())
		for line in lines:
			try:
				d = json.loads(line)
				kind = d.get('type')
				if st['start'] is None and d.get('timestamp'):
					st['start'] = iso_epoch(d['timestamp'])
				if kind == 'ai-title':
					st['ai'] = d.get('aiTitle') or st['ai']
				elif kind == 'custom-title':
					st['custom'] = d.get('customTitle') or st['custom']
				elif kind == 'last-prompt':
					st['prompt'] = d.get('lastPrompt') or st['prompt']
				elif kind == 'user' and not d.get('isMeta'):
					st['doing'] = None
					c = (d.get('message') or {}).get('content')
					if isinstance(c, str) or any(isinstance(x, dict) and x.get('type') == 'text' for x in c or ()):
						st['ultra'] = False
				# ultracode opt-in lands as an attachment after its prompt; match the type only, since CLAUDE.md/memory text can mention the word
				at = str((d.get('attachment') or {}).get('type'))
				if kind == 'attachment' and (at == 'workflow_keyword_request' or 'ultracode' in at):
					st['ultra'] = True
				if kind != 'assistant':
					continue
				st['effort'] = d.get('effort') or st['effort']
				m = d.get('message') or {}
				mid = m.get('id')
				u = m.get('usage') or {}
				vals = {
					'in': int(u.get('input_tokens', 0) or 0) + int(u.get('cache_creation_input_tokens', 0) or 0),
					'cache': int(u.get('cache_read_input_tokens', 0) or 0),
					'out': int(u.get('output_tokens', 0) or 0),
					'ctx': int(u.get('input_tokens', 0) or 0)
					+ int(u.get('cache_creation_input_tokens', 0) or 0)
					+ int(u.get('cache_read_input_tokens', 0) or 0),
					'model': m.get('model'),
				}
				if mid:
					st['ids'][mid] = vals
				st['latest'] = vals
				blocks = [b for b in m.get('content') or () if isinstance(b, dict)]
				if blocks:
					st['doing'] = block_brief(blocks[-1])
			except Exception:
				pass
		CACHE[p] = st
		vals = list(st['ids'].values())
		latest = st['latest'] or {}
		return {
			'in': sum(v['in'] for v in vals),
			'cache': sum(v['cache'] for v in vals),
			'out': sum(v['out'] for v in vals),
			'ctx': latest.get('ctx'),
			'model': latest.get('model'),
			'effort': st['effort'],
			'ultra': st['ultra'],
			'start': st['start'],
			'title': st['custom'] or st['ai'],
			'prompt': st['prompt'],
			'doing': st['doing'],
		}
	except (OSError, ValueError):
		return {}


def rollout_tokens(path):
	key = 'rollout:' + str(path)
	TOUCHED.add(key)
	try:
		st = CACHE.get(key)
		if not st or os.path.getsize(path) < st['size']:
			st = {
				'size': 0,
				'partial': b'',
				'meta': {},
				'model': None,
				'effort': None,
				'limits': None,
				'last': None,
				'doing': None,
			}
		with open(path, 'rb') as f:
			f.seek(st['size'])
			chunk = f.read()
		lines = (st['partial'] + chunk).split(b'\n')
		st = dict(st, size=st['size'] + len(chunk), partial=lines.pop())
		for raw in lines:
			try:
				d = json.loads(raw)
				p = d.get('payload') or {}
				kind = d.get('type')
				pt = p.get('type')
				if kind == 'session_meta':
					st['meta'] = p
				if kind == 'turn_context':
					st['model'] = p.get('model', st['model'])
					st['effort'] = p.get('effort') or p.get('reasoning_effort') or st['effort']
				if kind == 'event_msg' and pt == 'token_count':
					st['last'] = p.get('info') or {}
					st['limits'] = p.get('rate_limits') or st['limits']
				if kind == 'response_item':
					if pt in ('custom_tool_call', 'function_call'):
						arg = next(
							(x for x in str(p.get('input') or p.get('arguments') or '').splitlines() if x.strip()), ''
						)
						st['doing'] = oneline(f"{p.get('name') or 'tool'}: {arg}" if arg else p.get('name') or 'tool')
					elif pt in ('reasoning', 'message') or pt.endswith('_output'):
						st['doing'] = None
			except Exception:
				pass
		CACHE[key] = st
	except OSError:
		st = {'meta': {}, 'model': None, 'effort': None, 'limits': None, 'last': None, 'doing': None}
	last = st['last']
	if not last:
		return st['meta'], {}, st['model'], st['effort'], st['limits'], st['doing']
	usage = last.get('total_token_usage') or {}
	return (
		st['meta'],
		{
			'in': max(0, int(usage.get('input_tokens', 0)) - int(usage.get('cached_input_tokens', 0))),
			'cache': int(usage.get('cached_input_tokens', 0)),
			'out': int(usage.get('output_tokens', 0)),
			'ctx': (last.get('last_token_usage') or {}).get('input_tokens'),
			'window': last.get('model_context_window'),
		},
		st['model'],
		st['effort'],
		st['limits'],
		st['doing'],
	)


def codex_titles():
	titles = {}
	try:
		text = (HOME / '.codex/session_index.jsonl').read_text()
	except OSError:
		return titles
	for line in text.splitlines():
		try:
			d = json.loads(line)
			titles[d['id']] = d.get('thread_name')
		except Exception:
			pass
	return titles


def codex_limits(rl):
	win = lambda m: '?' if not m else f'{m // 1440}d' if m % 1440 == 0 else f'{m // 60}h' if m % 60 == 0 else f'{m}m'
	items = [
		(win(w.get('window_minutes')), w['used_percent'], w.get('resets_at'))
		for w in (rl.get('primary'), rl.get('secondary'))
		if w and w.get('used_percent') is not None
	]
	c = rl.get('credits') or {}
	extra = (
		'credits ∞'
		if c.get('unlimited')
		else f"credits {c['balance']}"
		if c.get('balance') is not None
		else 'credits 0'
		if c.get('has_credits') is False
		else None
	)
	return items, [extra] if extra else []


def claude_limits(u):
	items = []
	for l in u.get('limits') or []:
		if l.get('percent') is None:
			continue
		g = {'session': '5h', 'weekly': '7d'}.get(l.get('group'), l.get('group') or '?')
		m = ((l.get('scope') or {}).get('model') or {}).get('display_name')
		items.append((f'{m.lower()} {g}' if m else g, l['percent'], iso_epoch(l.get('resets_at'))))
	s = u.get('spend') or {}
	money = lambda m: (
		f"{m['amount_minor'] / 10 ** m.get('exponent', 2):.{m.get('exponent', 2)}f}"
		if isinstance(m, dict) and m.get('amount_minor') is not None
		else None
	)
	used, cap, cur = money(s.get('used')), money(s.get('limit')), (s.get('used') or {}).get('currency', '')
	return items, [f'extra {used}/{cap} {cur}'.rstrip() if cap else f'extra {used} {cur}'.rstrip()] if s.get(
		'enabled'
	) and used else []


def copilot_limits(u):
	reset = iso_epoch(u.get('quota_reset_date'))
	snaps = u.get('quota_snapshots') or {}
	return [
		(label, 100 - q['percent_remaining'], reset)
		for key, label in (('premium_interactions', 'prem'), ('chat', 'chat'), ('completions', 'compl'))
		if (q := snaps.get(key)) and not q.get('unlimited') and q.get('percent_remaining') is not None
	], []


def claude_fetch():
	token = None
	for name in ('.credentials.json', '.credentials'):
		try:
			token = json.loads((HOME / '.claude' / name).read_text())['claudeAiOauth']['accessToken']
			break
		except Exception:
			pass
	if not token:
		return None
	req = urllib.request.Request(
		'https://api.anthropic.com/api/oauth/usage',
		headers={'Authorization': 'Bearer ' + token, 'anthropic-beta': 'oauth-2025-04-20'},
	)
	try:
		with urllib.request.urlopen(req, timeout=5) as r:
			return claude_limits(json.loads(r.read()))
	except urllib.error.HTTPError as e:
		return ([], ['login expired']) if e.code == 401 else None
	except Exception:
		return None


def copilot_fetch():
	try:
		r = subprocess.run(
			['gh', 'api', '/copilot_internal/user'], stdin=subprocess.DEVNULL, capture_output=True, timeout=5
		)
		return copilot_limits(json.loads(r.stdout)) if r.returncode == 0 else None
	except Exception:
		return None


def fetch_limits(letters, due):
	now = time.time()
	for letter, fn, every in (('C', claude_fetch, 120), ('P', copilot_fetch, 300)):
		if letter in letters and now >= due.get(letter, 0):
			due[letter] = now + every
			r = fn()
			if r is not None:
				LIMITS[letter] = r


def limits_loop():
	due = {}
	# no network while the limits are hidden
	while True:
		SHOW_LIMITS.wait()
		fetch_limits(LIVE, due)
		time.sleep(1)


def limit_row(letter, items, extras, colored, now):
	parts = []
	for i, (label, pct, reset) in enumerate(items):
		c = ('\033[1;31m' if pct >= 90 else '\033[33m' if pct >= 75 else '') if colored else ''
		parts.append(
			f'{label} {c}{pct:.0f}%{RESET if c else ""}'
			+ (f' ↻{dur(reset - now)}' if reset and reset > now and (i == 0 or pct >= 75) else '')
		)
	return (COLORS.get(letter, '') + letter + RESET if colored else letter) + ' ' + '  '.join(parts + extras)


def claude_subagents(project_dir, session_id):
	running = []
	root = Path(project_dir) / str(session_id) / 'subagents'
	for transcript in root.rglob('agent-*.jsonl'):  # rglob: workflow agents live in subagents/workflows/<id>/
		try:
			mt = os.path.getmtime(transcript)
		except OSError:
			continue
		if time.time() - mt >= 600:
			continue
		try:
			meta = json.loads(transcript.with_name(transcript.stem + '.meta.json').read_text())
		except Exception:
			meta = {}
		if meta.get('finished'):
			continue
		tok = token_sum(transcript)
		running.append(
			{
				'type': meta.get('agentType') or '?',
				'description': meta.get('description') or '',
				'since': tok.get('start') or mt,
				'tok': tok,
				'state': 'work' if time.time() - mt < 20 else 'idle',
			}
		)
	return running


def procargs(pid):
	try:
		return [x.decode(errors='ignore') for x in Path('/proc', str(pid), 'cmdline').read_bytes().split(b'\0') if x]
	except Exception:
		return []


def proc_cwd(pid):
	try:
		return os.readlink(f'/proc/{pid}/cwd')
	except OSError:
		return ''


def live_claude(table):
	out = []
	root = HOME / '.claude/sessions'
	try:
		files = root.glob('*.json')
	except OSError:
		return out
	for f in files:
		try:
			d = json.loads(f.read_text())
			pid = int(d.get('pid'))
			pi = table.get(pid)
			if not pi or str(pi['start']) != str(d.get('procStart')):
				continue
			sid = d.get('sessionId', '')
			cwd = d.get('cwd', '')
			candidates = [HOME / '.claude/projects' / slug(cwd) / (sid + '.jsonl')]
			if not candidates[0].exists():
				candidates = glob.glob(str(HOME / '.claude/projects/*' / (sid + '.jsonl')))
			tok = token_sum(candidates[0]) if candidates else {}
			try:
				mt = os.path.getmtime(candidates[0]) if candidates else None
			except OSError:
				mt = None
			status = d.get('status', '')
			out.append(
				{
					'pid': pid,
					'ppid': pi['ppid'],
					'letter': 'C',
					'name': d.get('name') or os.path.basename(cwd) or 'claude',
					'model': tok.get('model'),
					'effort': tok.get('effort'),
					'ultra': tok.get('ultra'),
					'since': pi['since'],
					'status': status,
					'state': state_for_claude(status, mt),
					'tok': tok,
					'project_dir': str(Path(candidates[0]).parent) if candidates else '',
					'session_id': sid,
					'cwd': cwd,
					'waiting': d.get('waitingFor'),
				}
			)
		except Exception:
			continue
	return out


def live_codex(table):
	out = []
	titles = None
	base = str(HOME / '.codex/sessions')
	for pid, pi in table.items():
		if pi['exe'] != 'codex':
			continue
		rollout = None
		try:
			for fd in os.listdir(f'/proc/{pid}/fd'):
				target = os.readlink(f'/proc/{pid}/fd/{fd}')
				if target.startswith(base) and '/rollout-' in target and target.endswith('.jsonl'):
					rollout = target
					break
		except OSError:
			pass
		if not rollout:
			continue
		meta, tok, model, effort, limits, doing = rollout_tokens(rollout)
		if not model:
			args = procargs(pid)
			for i, a in enumerate(args):
				if a in ('-m', '--model') and i + 1 < len(args):
					model = args[i + 1]
		try:
			mt = os.path.getmtime(rollout)
		except OSError:
			mt = 0
		if titles is None:
			titles = codex_titles()
		sid = meta.get('id') or (re.search(r'([0-9a-f-]{36})\.jsonl$', rollout) or [None, None])[1]
		cwd = meta.get('cwd', '') or proc_cwd(pid)
		out.append(
			{
				'pid': pid,
				'ppid': pi['ppid'],
				'letter': 'X',
				'name': os.path.basename(cwd) or 'codex',
				'model': model or 'codex',
				'effort': effort,
				'since': pi['since'],
				'status': '',
				'state': 'work' if time.time() - mt < 10 else 'idle',
				'tok': dict(tok, doing=doing),
				'limits': limits,
				'mt': mt,
				'cwd': cwd,
				'title': titles.get(sid),
			}
		)
	return out


def live_misc(table):
