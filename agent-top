		model = ''
		if match is None and len(args) > 1 and os.path.basename(args[0]) == 'ollama' and args[1] == 'run':
			match = 'ollama'
			model = args[2] if len(args) > 2 else ''
		if match is None and len(args) > 1 and os.path.basename(args[0]) == 'ollama' and args[1] == 'runner':
			match = 'ollama-runner'
		if match is None:
			continue
		if match in ('llama-server', 'llama-cli'):
			for i, a in enumerate(args):
				if a in ('-m', '--model') and i + 1 < len(args):
					model = re.sub(r'\.gguf$', '', os.path.basename(args[i + 1]))
		if match == 'llama-server' and table.get(pi['ppid'], {}).get('comm') == 'ollama':
			match = 'ollama-runner'
		letter = 'L' if match == 'ollama-runner' else names.get(match, 'L')
		cwd = proc_cwd(pid)
		out.append(
			{
				'pid': pid,
				'ppid': pi['ppid'],
				'letter': letter,
				'name': model or os.path.basename(cwd) or match,
				'model': match,
				'since': pi['since'],
				'status': '',
				'state': 'idle',
				'tok': {},
				'misc': True,
				'tty': pi['tty'],
				'cwd': cwd,
				'ollama_runner': match == 'ollama-runner',
			}
		)
	return out


def copilot_usage(sessions):
	try:
		db = HOME / '.copilot/session-store.db'
		con = sqlite3.connect(f'file:{db}?mode=ro', uri=True, timeout=0.1)
		con.row_factory = sqlite3.Row
		cols = {r['name'] for r in con.execute('PRAGMA table_info(assistant_usage_events)')}
		scols = {r['name'] for r in con.execute('PRAGMA table_info(sessions)')}
		if not cols or not {'session_id', 'cwd'}.issubset(scols):
			con.close()
			return
		for a in sessions:
			if a['letter'] != 'P':
				continue
			row = (
				con.execute(
					'SELECT id FROM sessions WHERE cwd=? ORDER BY updated_at DESC LIMIT 1',
					(a.get('cwd') or proc_cwd(a['pid']),),
				).fetchone()
				if 'updated_at' in scols
				else None
			)
			if not row:
				continue
			keys = [k for k in ('input_tokens', 'output_tokens', 'model') if k in cols]
			if keys:
				ev = con.execute(
					'SELECT '
					+ ','.join(keys)
					+ ' FROM assistant_usage_events WHERE session_id=? ORDER BY rowid DESC LIMIT 1',
					(row['id'],),
				).fetchone()
				if ev:
					a['tok'] = {'in': ev['input_tokens'] or 0, 'out': ev['output_tokens'] or 0}
					a['model'] = ev['model'] or a['model']
		con.close()
	except Exception:
		pass


def local_lines():
	lines = []
	try:
		with urllib.request.urlopen('http://127.0.0.1:11434/api/ps', timeout=0.3) as r:
			data = json.loads(r.read())
		for m in data.get('models', []):
			lines.append(
				{
					'name': m.get('name', 'ollama'),
					'text': f"{m.get('name', 'ollama')} vram {int(m.get('size_vram', 0) or 0) / 1e9:.1f}G",
				}
			)
	except Exception:
		pass
	return lines


def topic(a):
	# capped: an untitled session falls back to its whole prompt, which widened the popup to 110 columns
	return oneline(a['tok'].get('title') or a['tok'].get('prompt') or a.get('title'), 36)


def activity(a):
	"""Only what the state indicator can't show: the tool being run, or why it needs you."""
	return a.get('waiting') if a['state'] == 'wait' else a['tok'].get('doing') if a['state'] == 'work' else None


def scan(sync=False):
	global LIVE
	table = read_proc_table()
	stamp = time.monotonic()
	now = time.time()
	agents = live_claude(table) + live_codex(table) + live_misc(table)
	copilot_usage(agents)
	for a in agents:
		if a.get('misc'):
			a['state'] = 'work' if cpu_percent(a['pid'], table, stamp) > 5 else 'idle'
	for p in CPU_PREV.keys() - table.keys():
		del CPU_PREV[p]
	runners = [a for a in agents if a.get('ollama_runner') and a['state'] == 'work']
	# resident model servers (ollama runners, whatisit's llama-server) only count while computing; no tty = daemon
	agents = sorted(
		(a for a in agents if not a.get('ollama_runner') and (not a.get('misc') or a['tty'] or a['state'] == 'work')),
		key=lambda a: a['since'],
	)
	local = local_lines() if runners else []
	lrow = lambda m, indent: {
		'state': 'work',
		'letter': 'L',
		'indent': indent,
		'name': m['text'],
		'since': runners[0]['since'] if len(runners) == 1 else None,
	}
	claimed = {}
	for m in local:
		owner = next((a for a in agents if a['model'] == m['name'] and not a.get('misc')), None)
		if owner:
			claimed.setdefault(owner['pid'], []).append(m)
	LIVE = {a['letter'] for a in agents}
	if sync:
		fetch_limits(LIVE, {})
	bypid = {a['pid']: a for a in agents}
	total_in = sum(a['tok'].get('in', 0) for a in agents)
	total_out = sum(a['tok'].get('out', 0) for a in agents)
	rows = ['HEAD']
	if not agents:
		rows.append('no live sessions')
	children = {a['pid']: [] for a in agents}
	roots = []
	for a in agents:
		parent = a['ppid']
		seen = set()
		while parent not in seen:
			seen.add(parent)
			if parent in bypid:
				children[parent].append(a)
				break
			pi = table.get(parent)
			if not pi:
				roots.append(a)
				break
			parent = pi['ppid']
		else:
			roots.append(a)
	seen = set()

	def add(a, indent=''):
		nonlocal total_in, total_out
		if a['pid'] in seen:
			return
		seen.add(a['pid'])
		t = a['tok']
		rows.append(
			{
				'state': a['state'],
				'letter': a['letter'],
				'indent': indent,
				'name': a['name'],
				'meta': ' '.join(x for x in (model_short(a['model']), a.get('effort')) if x),
				'ultra': a.get('ultra'),
				'since': a['since'],
				'pid': a['pid'],
				'topic': topic(a),
			}
		)
		pad = ' ' * (len(indent) + 2)
		if act := activity(a):
			rows.append({'kind': 'activity', 'text': pad + '→ ' + act})
		detail = ' '.join(f'{k} {fmt(t[k])}' for k in ('in', 'cache', 'out', 'ctx') if t.get(k) is not None)
		if detail:
			rows.append(
				{'kind': 'tokens', 'text': pad + detail + (f"/{fmt(t.get('window'))}" if t.get('window') else '')}
			)
		for m in claimed.get(a['pid'], []):
			rows.append(lrow(m, pad + '└ '))
		if a['letter'] == 'C':
			for sub in claude_subagents(a.get('project_dir', ''), a.get('session_id', '')):
				st = sub['tok']
				rows.append(
					{
						'state': sub['state'],
						'letter': 'A',
						'indent': pad + '└ ',
						'name': sub['type'],
						'meta': ' '.join(
							x for x in (st.get('model') and model_short(st['model']), st.get('effort')) if x
						),
						'since': sub['since'],
						'desc': oneline(sub['description'], 36),
						'topic': oneline(sub['description'], 36),
					}
				)
				if st.get('doing'):
					rows.append({'kind': 'activity', 'text': pad + '    → ' + st['doing']})
				sd = ' '.join(f'{k} {fmt(st[k])}' for k in ('in', 'cache', 'out') if st.get(k) is not None)
				if sd:
					rows.append({'kind': 'tokens', 'text': pad + '    ' + sd})
				total_in += st.get('in', 0)
				total_out += st.get('out', 0)
		for ch in children.get(a['pid'], []):
			add(ch, pad + '└ ')

	for a in roots:
		add(a)
	free = [m for m in local if not any(m in v for v in claimed.values())]
	if free:
		rows += [lrow(m, '') for m in free]
	codex = max((a for a in agents if a.get('limits')), key=lambda a: a['mt'], default=None)
	lims = {'C': LIMITS.get('C'), 'X': codex and codex_limits(codex['limits']), 'P': LIMITS.get('P')}
	foot = [(k,) + lims[k] for k in 'CXP' if k in LIVE and lims[k] and (lims[k][0] or lims[k][1])]
	# drop parse caches of transcripts that are no longer live
	for k in CACHE.keys() - TOUCHED:
		del CACHE[k]
	TOUCHED.clear()
	return {
		'rows': rows,
		'foot': foot,
		'count': len(agents),
		'work': sum(a['state'] == 'work' for a in agents),
		'wait': sum(a['state'] == 'wait' for a in agents),
		'in': total_in,
		'out': total_out,
	}


def render(data, width, height=None, colored=True, sel=None, owners=None):
	"""owners, when given, is filled with the agent pid each screen line belongs to (for mouse clicks)."""
	now = time.time()
	tick = int(time.monotonic() * 8)
	g, y, d, z, mag = ('\033[32m', '\033[1;33m', '\033[2m', RESET, '\033[1;35m') if colored else ('',) * 5
	body = []
	own = []
	cur = None
	for row in data['rows']:
		cur = row.get('pid', cur) if isinstance(row, dict) else None
		if row == 'HEAD':
			s = (
				f"{data['count']} live"
				+ (f" · {g}{data['work']} work{z}" if data['work'] else '')
				+ (f" · {y}{data['wait']} wait{z}" if data['wait'] else '')
				+ f"  {d}in{z} {fmt(data['in'])} {d}out{z} {fmt(data['out'])}"
				+ ('' if VIEW['help'] else f'  {d}? keys{z}')
				+ (f'  {y}{NOTE[0]}{z}' if NOTE[1] > now else '')
			)
		elif isinstance(row, str):
			s = row
		elif row.get('kind'):
			if not VIEW[row['kind']]:
				continue
			s = d + row['text'] + z
		else:
			state = row['state']
			letter = row['letter']
			indent = row.get('indent', '')
			indicator = (
				SPINNER[tick % len(SPINNER)]
				if state == 'work'
				else ('●' if tick % 4 < 2 else ' ')
				if state == 'wait'
				else '·'
			)
			fixed = (
				(' ' + row['meta'] if VIEW['model'] and row.get('meta') else '')
				+ (' ultracode' if VIEW['model'] and row.get('ultra') else '')
				+ (' ' + clock(now - row['since']) if VIEW['clock'] and row.get('since') else '')
			)
			name = row.get('topic') if VIEW['topic'] and row.get('topic') else row['name']
			desc = ' ' + row['desc'] if row.get('desc') and name != row['desc'] else ''
			# shorten the name, not the clock, when the row is too wide
			room = width - 4 - len(indent) - len(fixed)
			if len(name) > room:
				name = name[: max(1, room - 1)] + '…'
			if colored:
				sc = {'work': g, 'wait': y, 'idle': d}[state]
				fixed = fixed.replace(' ultracode', z + mag + ' ultracode' + z + sc)
				s = (
					sc
					+ indicator
					+ z
					+ ' '
					+ indent
					+ COLORS.get(letter, '')
					+ letter
					+ z
					+ ' '
					+ sc
					+ name
					+ fixed
					+ desc
					+ z
				)
			else:
				s = indicator + ' ' + indent + letter + ' ' + name + fixed + desc
			if sel is not None and row.get('pid') == sel:
				s = (
					('\033[7m' + s.replace(z, z + '\033[7m') + ' ' * max(0, width - visible_len(s)) + z)
					if colored
					else '>' + s[1:]
				)
		body.append(s)
		own.append(cur)
	foot = []
	if VIEW['limits']:
		foot += [limit_row(*f, colored, now) for f in data['foot']] or [d + 'limits …' + z]
	if VIEW['help']:
		foot += [d + x + z for x in LEGEND]
	if height:
		room = max(0, height - len(foot))
		if len(body) > room > 1:
			body = body[: room - 1] + [f'{d}… {len(body) - room + 1} more lines (t a i hide detail){z}']
			own = own[: room - 1]
		body += [''] * (room - len(body))
	if owners is not None:
		owners[:] = own
	return '\n'.join(truncate(s, width) for s in body + foot)


def run(*cmd):
	try:
		return subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=3).stdout
	except Exception:
		return ''


def ancestors(pid):
	while pid > 1:
		yield pid
		try:
			raw = Path('/proc', str(pid), 'stat').read_text()
			pid = int(raw[raw.rfind(')') + 2 :].split()[1])
		except (OSError, ValueError, IndexError):
			return


def jump(pid):
	"""Bring up the terminal (and tmux pane) the agent runs in; False when there is none."""
	target = pid
	session = None
	try:
		tty_path = os.readlink(f'/proc/{pid}/fd/0')
	except OSError:
		tty_path = ''
	pane = next(
		(
			f
			for f in (
				l.split()
				for l in run('tmux', 'list-panes', '-a', '-F', '#{pane_id} #{pane_tty} #{session_name}').splitlines()
			)
			if tty_path and f[1:2] == [tty_path]
		),
		None,
	)
	if pane:
		clients = [
			f
			for f in (
				l.split()
				for l in run('tmux', 'list-clients', '-F', '#{client_tty} #{client_pid} #{session_name}').splitlines()
			)
			if len(f) == 3 and f[0].startswith('/dev/')
		]
		dropdown = lambda c: any('--drop-down' in procargs(p) for p in ancestors(int(c[1])))
		c = (
			next((c for c in clients if c[2] == pane[2]), None)
			or next((c for c in clients if dropdown(c)), None)
			or (clients[0] if clients else None)
		)
		if not c:
			return False
		run(
			'tmux',
			'switch-client',
			'-c',
			c[0],
			'-t',
			pane[0],
			';',
			'select-window',
			'-t',
			pane[0],
			';',
			'select-pane',
			'-t',
			pane[0],
		)
		target = int(c[1])
		session = pane[2]
	wins = {}
	for f in (l.split() for l in run('wmctrl', '-lp').splitlines()):
		if len(f) > 2:
			wins.setdefault(f[2], f[0])
	for p in ancestors(target):
		if '--drop-down' in procargs(p):
			shown = run('xdotool', 'search', '--onlyvisible', '--role', 'xfce4-terminal-dropdown').split()
			if shown:
				run('xdotool', 'windowactivate', shown[0])
				return True
			try:
				subprocess.Popen(
					[str(HOME / 'documents/scripts/dropdown_terminal.sh')] + ([session] if session else []),
					stdin=subprocess.DEVNULL,
					stdout=subprocess.DEVNULL,
					stderr=subprocess.DEVNULL,
					start_new_session=True,
				)
			except OSError:
				return False
			return True
		if str(p) in wins:
			run('wmctrl', '-ia', wins[str(p)])
			return True
	return False


def jump_and_hide(pid):
	if not jump(pid):
		NOTE[:] = ['no terminal found', time.time() + 3]
	elif os.environ.get('WINDOWID'):
		run('xdotool', 'windowminimize', os.environ['WINDOWID'])


