#!/bin/sh
# Installs agent-top and its toggle into ~/.local/bin and binds Super+Z to the popup.
set -eu
cd "$(dirname "$0")"
install -Dm755 agent-top "$HOME/.local/bin/agent-top"
install -Dm755 agent-top-toggle "$HOME/.local/bin/agent-top-toggle"
# xfconfd caches settings, so the binding goes through xfconf-query rather than the XML file.
key='/commands/custom/<Super>z'
xfconf-query -c xfce4-keyboard-shortcuts -p "$key" -s "$HOME/.local/bin/agent-top-toggle" 2>/dev/null \
    || xfconf-query -c xfce4-keyboard-shortcuts -p "$key" -n -t string -s "$HOME/.local/bin/agent-top-toggle"
# a running popup keeps its parse cache, so close it; Super+Z starts a fresh one
pkill -f "^python3 $HOME/.local/bin/agent-top" || true
echo 'Installed. Super+Z opens Agent Top.'
